{
  "name": "mocktrade-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for evaluating AI trading agents with simulated orders, risk rules, and historical replay backtests.",
  "type": "module",
  "bin": {
    "mocktrade-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run build && npm test",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "trading",
    "evaluation",
    "sandbox",
    "ai-agent",
    "backtest",
    "alpaca",
    "polygon"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
